{
  "name": "petri",
  "version": "0.1.0",
  "private": true,
  "description": "Reaction-diffusion playground: grow coral, fingerprints and mitosis in your browser with WebGL2.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "render": "tsx scripts/render.ts"
  },
  "devDependencies": {
    "@types/node": "20.17.9",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lukietoo/petri.git"
  },
  "homepage": "https://lukietoo.github.io/petri/",
  "keywords": [
    "reaction-diffusion",
    "gray-scott",
    "webgl2",
    "generative-art",
    "creative-coding",
    "simulation"
  ],
  "engines": {
    "node": ">=20"
  }
}
